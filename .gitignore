# OS and editor noise
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Local environment and secrets
.env
.env.*
!.env.example

# Dependencies and package-manager caches
node_modules/
.pnpm-store/
.yarn/

# Logs and temporary files
*.log
*.tmp
*.temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build and cache output
dist/
build/
.cache/
.parcel-cache/
.vite/

# Archives and generated bundles
*.zip
*.tar
*.tar.gz
*.tgz

# Open Design / local runtime artifacts
.od/
.opendesign/

# Loose screenshots / scratch images at repo ROOT only.
# Subfolder images (screenshots/, uploads/, shapes-data/references/, etc.)
# stay tracked. To deliberately commit a root image: `git add -f <file>`.
/*.png
/*.jpg
/*.jpeg

# Windows reserved-name artifact, created when `2>nul`/`>nul` is run under
# git-bash (treats `nul` as a literal filename instead of the null device).
/nul

